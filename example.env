# ========================================
# Base de Datos
# ========================================

# URL de conexión a PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patients"

# ========================================
# Prisma
# ========================================

# Evitar autoinstalación del cliente Prisma
PRISMA_GENERATE_SKIP_AUTOINSTALL=false

# ========================================
# Next.js
# ========================================

# Desactivar telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1

# Modo de Node.js (development | production)
NODE_ENV=development

# ========================================
# Docker (solo para docker-compose)
# ========================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patients
POSTGRES_PORT=5432

# Aplicación
APP_PORT=3000
